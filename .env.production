# Production Environment Configuration
# ⚠️ DO NOT commit secrets to this file - use secure secret management

# Database Configuration (use managed database service like AWS RDS)
DATABASE_URL=postgresql://user:secure_password@db-host:5432/medicare_ai

# Backend Server Configuration
BACKEND_PORT=5000
NODE_ENV=production

# JWT Configuration (Generate strong random: openssl rand -base64 32)
JWT_SECRET=generate-a-strong-random-string-here

# CORS - Your production frontend domain
ALLOWED_ORIGINS=https://yourmedicalai.com,https://www.yourmedicalai.com

# Frontend API Configuration
VITE_API_BASE_URL=https://api.yourmedicalai.com/api
VITE_BACKEND_URL=https://api.yourmedicalai.com

# ML/NLP Services
VITE_ML_SERVICE_URL=https://ml.yourmedicalai.com
VITE_NLP_SERVICE_URL=https://nlp.yourmedicalai.com

# API Keys (from external services)
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# Application Settings
VITE_APP_ENV=production
VITE_APP_DEBUG=false
VITE_LOG_LEVEL=info
